<section component-id="{{ componentId }}" data-testid="store-home-sanmar-tiles" class="s-block sm-block sm-sec">
<div class="container"><div class="sm-tiles">
{% for t in component.tiles %}
 {% set smk = 'box' %}{% set smn = t.label ~ " " ~ t.title %}{% if 'صحية' in smn or 'حمام' in smn %}{% set smk = 'bath' %}{% elseif 'كهرب' in smn %}{% set smk = 'bolt' %}{% elseif 'لواصق' in smn or 'غراء' in smn %}{% set smk = 'tube' %}{% elseif 'بناء' in smn %}{% set smk = 'brick' %}{% elseif 'يدوية' in smn %}{% set smk = 'hammer' %}{% elseif 'بوية' in smn or 'دهان' in smn or 'كيماو' in smn %}{% set smk = 'bucket' %}{% elseif 'زراع' in smn %}{% set smk = 'leaf' %}{% elseif 'ليات' in smn %}{% set smk = 'pipe' %}{% elseif 'حقائب' in smn or 'شنط' in smn %}{% set smk = 'bag' %}{% elseif 'قفل' in smn or 'أقفال' in smn or 'كوالين' in smn %}{% set smk = 'lock' %}{% elseif 'جملة' in smn %}{% set smk = 'box' %}{% elseif 'سباك' in smn or 'محبس' in smn %}{% set smk = 'valve' %}{% elseif 'فلتر' in smn or 'مياه' in smn %}{% set smk = 'drop' %}{% elseif 'سخان' in smn %}{% set smk = 'heater' %}{% endif %}
 <a class="sm-card x{{ loop.index }}" href="{{ t.url }}"><div class="tx"><small>{{ t.label }}</small><h3>{{ t.title }}</h3><span class="ln">تسوق <svg class="sm-i " aria-hidden="true"><use href="#i-arrow"/></svg></span></div><i class="sm-bi"><svg class="sm-i" aria-hidden="true"><use href="#i-{{ smk }}"/></svg></i></a>
{% endfor %}
</div></div></section>
